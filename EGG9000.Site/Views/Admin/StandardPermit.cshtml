@using EGG9000.Common.Helpers
@model List<DBUser>
@{
    var xrefs = (List<UserCoopXref>)ViewBag.Xrefs;
    var demerits = (List<Demerit>)ViewBag.Demerits;
    var merits = (List<Merit>)ViewBag.Merits;

    var users = Model.SelectMany(x =>
        x.EggIncAccounts.Where(z => z.Backup.PermitLevel == 0).Select(account => {
            var accountXrefs = xrefs.Where(y => y.UserId == x.Id && y.EggIncId == account.Id);
            return new {
                x.Id,
                x.DiscordUsername,
                AccountName = account.Name,
                MultiAccount = x.EggIncAccounts.Count > 1,
                Backups = x.EggIncAccounts.Select(a => a.Backup),
                x.Registered,
                Xrefs = accountXrefs,
                Demerits = demerits.Where(y => y.UserId == x.Id),
                Merits = merits.Where(y => y.UserId == x.Id),
                LastRunnningScore = accountXrefs.OrderBy(y => y.CreatedOn).LastOrDefault()?.RunningScore ?? 0,
                x.DiscordId
            };
        }));
}
<style>
    .container {
        max-width: inherit !important;
    }
</style>

<h2>Standard Permits</h2>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>ID</th>
            <th>Accounts</th>
            <th>Joined</th>
            <th>Latest Co-op</th>
            <th>Demerits</th>
            <th>Merits</th>
            <th>Running Score</th>
            <th colspan="99">Last 10 scores</th>
        </tr>
    </thead>
    <tbody>
        @foreach(var user in users.OrderByDescending(x => x.LastRunnningScore)) {
            var accountLabel = user.MultiAccount ? $"{user.DiscordUsername} ({user.AccountName})" : user.DiscordUsername;
            <tr>
                <td><a href="/MyFarms/ViewUser?discordId=@(user.DiscordId)">@accountLabel</a></td>
                <td>@user.DiscordId</td>
                <td>@user.Backups.Count(x => x.PermitLevel == 0) of @user.Backups.Count()</td>
                <td>@user.Registered.Value.ToString("yyyy-M-d")</td>
                <td>@user.Xrefs.OrderBy(x => x.CreatedOn).LastOrDefault()?.CreatedOn.ToString("yyyy-M-d")</td>
                <td>@user.Demerits.Count()</td>
                <td>@user.Merits.Count()</td>
                <td>@user.Xrefs.OrderBy(x => x.CreatedOn).LastOrDefault()?.RunningScore</td>
                @foreach(var xref in user.Xrefs.Where(x => x.Score.HasValue).OrderByDescending(x => x.CreatedOn).Take(10)) {
                    <td>@Math.Log10(xref.Score.Value)</td>
                }
            </tr>
        }
    </tbody>
</table>

                <style>
                    td {
                        white-space: nowrap;
                    }
                    .container {
                        width: auto !important;
                    }
                </style>