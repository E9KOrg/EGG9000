@{
	Layout = "_Layout";
	ViewData["BodyClass"] = $"lb-page {ViewData["BodyClass"]}".Trim();
	var header = (LeaderboardHeader)ViewData[nameof(LeaderboardHeader)];
}

@section Head {
	<link rel="stylesheet" href="~/css/leaderboard.css" asp-append-version="true" />
	@RenderSection("Head", required: false)
}

<div class="card lb-card">
	<div class="card-header lb-toolbar">
		<h4 class="lb-title">@header.Title</h4>
		<div class="lb-controls">
			@foreach (var menu in header.Menus) {
				var active = menu.Choices.FirstOrDefault(x => x.Active);
				<div class="dropdown">
					<button class="btn btn-sm btn-outline-primary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
						@menu.Caption: @(active?.Label ?? "-")
					</button>
					<ul class="dropdown-menu dropdown-menu-end">
						@foreach (var choice in menu.Choices) {
							<li>
								<a class="dropdown-item @(choice.Active ? "active" : "")" href="@choice.Href" style="@(choice.Color is null ? "" : $"border-left:4px solid {choice.Color};color:{choice.Color};")">@choice.Label</a>
							</li>
						}
					</ul>
				</div>
			}
			@if (header.Jumps.Count == 1) {
				<a class="btn btn-sm btn-secondary" href="#@header.Jumps[0].Anchor">Jump to me</a>
			} else if (header.Jumps.Count > 1) {
				<div class="dropdown">
					<button class="btn btn-sm btn-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">Jump to me</button>
					<ul class="dropdown-menu dropdown-menu-end">
						@foreach (var jump in header.Jumps) {
							<li><a class="dropdown-item" href="#@jump.Anchor">@jump.Label</a></li>
						}
					</ul>
				</div>
			}
		</div>
	</div>
	<div class="lb-scroll">
		@RenderBody()
	</div>
</div>

@section Scripts {
	@RenderSection("Scripts", required: false)
}
