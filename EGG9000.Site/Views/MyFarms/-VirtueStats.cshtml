@using EGG9000.Site.Models.MyFarms
@model MyFarms_Partial_VirtueStatsModel
@{
    Ei.Egg[] virtueEggs = [Ei.Egg.Curiosity, Ei.Egg.Integrity, Ei.Egg.Humility, Ei.Egg.Resilience, Ei.Egg.Kindness];

    string eggAmount(double delivered) => delivered.ToEggString(numberOfDecimalPlaces: 3);
    int eggLevel(double delivered) => VirtueHelper.CurrentLevel(delivered);

    // Collapse consecutive snapshots that render identically at the table's precision.
    // Each surviving row keeps the earliest date its values appeared.
    var collapsedSnapshots = new List<UserSnapShot>();
    foreach (var s in Model.snapshots.Where(x => x.EggIncID == Model.backup.EggIncId).OrderByDescending(x => x.Date)) {
        if (collapsedSnapshots.Count > 0 && collapsedSnapshots[^1].VirtueStats.Equals(s.VirtueStats)) collapsedSnapshots[^1] = s;
        else collapsedSnapshots.Add(s);
    }

    var latestTePending = Model.backup.EggsOfTruthTotal - (int)Model.backup.EggsOfTruth;
    var latestDelivered = virtueEggs
        .Select((egg, i) => (egg, val: Model.backup.VirtueEggsDelivered.ElementAtOrDefault(i)))
        .ToDictionary(x => x.egg, x => x.val);

    var makeVirtuePoint = (DateTime date, Dictionary<Ei.Egg, double> delivered, int teTotal, uint teEarned, int tePending, uint shifts, uint resets) => new {
        date = date.ToString("yyyy-MM-dd"),
        curiosity = delivered.GetValueOrDefault(Ei.Egg.Curiosity),
        curiosityStr = eggAmount(delivered.GetValueOrDefault(Ei.Egg.Curiosity)),
        integrity = delivered.GetValueOrDefault(Ei.Egg.Integrity),
        integrityStr = eggAmount(delivered.GetValueOrDefault(Ei.Egg.Integrity)),
        humility = delivered.GetValueOrDefault(Ei.Egg.Humility),
        humilityStr = eggAmount(delivered.GetValueOrDefault(Ei.Egg.Humility)),
        resilience = delivered.GetValueOrDefault(Ei.Egg.Resilience),
        resilienceStr = eggAmount(delivered.GetValueOrDefault(Ei.Egg.Resilience)),
        kindness = delivered.GetValueOrDefault(Ei.Egg.Kindness),
        kindnessStr = eggAmount(delivered.GetValueOrDefault(Ei.Egg.Kindness)),
        teTotal,
        teEarned,
        tePending,
        shifts,
        resets
    };

    var virtueStatsPoints = collapsedSnapshots
        .OrderBy(s => s.Date)
        .Select(s => makeVirtuePoint(s.Date, s.VirtueStats.Delivered, s.VirtueStats.TeTotal, s.VirtueStats.TeEarned, s.VirtueStats.TePending, s.VirtueStats.ShiftCount, s.VirtueStats.Resets))
        .Append(makeVirtuePoint(DateTime.Today, latestDelivered, Model.backup.EggsOfTruthTotal, Model.backup.EggsOfTruth, latestTePending, Model.backup.ShiftCount, Model.backup.Resets))
        .ToArray();

    var virtueStatsJson = JsonConvert.SerializeObject(virtueStatsPoints, new JsonSerializerSettings { FloatFormatHandling = FloatFormatHandling.DefaultValue });
    var virtueStatsSuffix = Regex.Replace(Model.backup.EggIncId, @"[^a-zA-Z0-9]", "");
}

<div class="container" style="padding: 0 12px;">
    <div class="row">
        <div class="col-sm">
            <div class="card" style="margin-top:15px;" id="virtueStatsNarrowCard-@(virtueStatsSuffix)">
                <h4 class="card-header d-flex justify-content-between align-items-center flex-wrap gap-1">
                    <span style="white-space: nowrap; margin-right: 8px;">Virtue Progress Graph</span>
                    <div class="d-flex flex-wrap gap-1">
                        <button class="btn btn-sm btn-primary me-1" id="virtueStatsBtn-curiosity-@(virtueStatsSuffix)" onclick="virtueStatsToggle_@(virtueStatsSuffix)('curiosity')">Curiosity</button>
                        <button class="btn btn-sm btn-outline-secondary me-1" id="virtueStatsBtn-integrity-@(virtueStatsSuffix)" onclick="virtueStatsToggle_@(virtueStatsSuffix)('integrity')">Integrity</button>
                        <button class="btn btn-sm btn-outline-secondary me-1" id="virtueStatsBtn-humility-@(virtueStatsSuffix)" onclick="virtueStatsToggle_@(virtueStatsSuffix)('humility')">Humility</button>
                        <button class="btn btn-sm btn-outline-secondary me-1" id="virtueStatsBtn-resilience-@(virtueStatsSuffix)" onclick="virtueStatsToggle_@(virtueStatsSuffix)('resilience')">Resilience</button>
                        <button class="btn btn-sm btn-outline-secondary me-1" id="virtueStatsBtn-kindness-@(virtueStatsSuffix)" onclick="virtueStatsToggle_@(virtueStatsSuffix)('kindness')">Kindness</button>
                        <button class="btn btn-sm btn-outline-secondary me-1" id="virtueStatsBtn-teTotal-@(virtueStatsSuffix)" onclick="virtueStatsToggle_@(virtueStatsSuffix)('teTotal')">TE Total</button>
                        <button class="btn btn-sm btn-outline-secondary me-1" id="virtueStatsBtn-teEarned-@(virtueStatsSuffix)" onclick="virtueStatsToggle_@(virtueStatsSuffix)('teEarned')">TE Earned</button>
                        <button class="btn btn-sm btn-outline-secondary me-1" id="virtueStatsBtn-tePending-@(virtueStatsSuffix)" onclick="virtueStatsToggle_@(virtueStatsSuffix)('tePending')">TE Pending</button>
                        <button class="btn btn-sm btn-outline-secondary me-1" id="virtueStatsBtn-shifts-@(virtueStatsSuffix)" onclick="virtueStatsToggle_@(virtueStatsSuffix)('shifts')">Shifts</button>
                        <button class="btn btn-sm btn-outline-secondary me-1" id="virtueStatsBtn-resets-@(virtueStatsSuffix)" onclick="virtueStatsToggle_@(virtueStatsSuffix)('resets')">Resets</button>
                    </div>
                </h4>
                <div class="card-body p-2">
                    <div id="virtueStatsChartNarrow-@(virtueStatsSuffix)"></div>
                </div>
            </div>
            <div class="card" style="margin-top:15px;">
                <h4 class="card-header" style="text-align: center;">Virtue Progress History</h4>
                <div class="table-responsive">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>TE (Total)</th>
                                <th>TE (Earned)</th>
                                <th>TE (Pending)</th>
                                <th>Current Egg</th>
                                @foreach (var egg in virtueEggs) {
                                    <th style="text-align: center;">@egg</th>
                                }
                                <th>Shifts</th>
                                <th>Resets</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>Latest</td>
                                <td>@Model.backup.EggsOfTruthTotal</td>
                                <td>@Model.backup.EggsOfTruth</td>
                                <td>@latestTePending</td>
                                <td>@Model.backup.MaxEggReached</td>
                                @foreach (var egg in virtueEggs) {
                                    <td style="text-align: center;">@eggAmount(latestDelivered[egg]) <span class="text-muted">(@eggLevel(latestDelivered[egg]))</span></td>
                                }
                                <td>@Model.backup.ShiftCount</td>
                                <td>@Model.backup.Resets</td>
                            </tr>
                            @foreach (var snapshot in collapsedSnapshots) {
                                <tr>
                                    <td>@snapshot.Date.ToString("yyyy-MM-dd")</td>
                                    <td>@snapshot.VirtueStats.TeTotal</td>
                                    <td>@snapshot.VirtueStats.TeEarned</td>
                                    <td>@snapshot.VirtueStats.TePending</td>
                                    <td>@snapshot.VirtueStats.CurrentEgg</td>
                                    @foreach (var egg in virtueEggs) {
                                        var delivered = snapshot.VirtueStats.Delivered.GetValueOrDefault(egg);
                                        <td style="text-align: center;">@eggAmount(delivered) <span class="text-muted">(@eggLevel(delivered))</span></td>
                                    }
                                    <td>@snapshot.VirtueStats.ShiftCount</td>
                                    <td>@snapshot.VirtueStats.Resets</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
<partial name="_ApexCharts" />
<script src="~/js/virtue-stats-chart.js" asp-append-version="true"></script>
<script>
    initVirtueStatsChart('@(virtueStatsSuffix)', @Html.Raw(virtueStatsJson));
</script>
