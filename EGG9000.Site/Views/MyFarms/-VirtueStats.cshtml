@model (CustomBackup backup, List<UserSnapShot> snapshots, bool isAdmin)
@{
    Ei.Egg[] virtueEggs = [Ei.Egg.Curiosity, Ei.Egg.Integrity, Ei.Egg.Humility, Ei.Egg.Resilience, Ei.Egg.Kindness];

    string eggAmount(double delivered) => delivered.ToEggString(numberOfDecimalPlaces: 3);
    int eggLevel(double delivered) => VirtueHelper.CurrentLevel(delivered);

    // Collapse consecutive snapshots that render identically at the table's precision.
    // Each surviving row keeps the earliest date its values appeared.
    var collapsedSnapshots = new List<UserSnapShot>();
    foreach (var s in Model.snapshots.Where(x => x.EggIncID == Model.backup.EggIncId).OrderByDescending(x => x.Date)) {
        if (collapsedSnapshots.Count > 0 && collapsedSnapshots[^1].VirtueStats.Equals(s.VirtueStats)) collapsedSnapshots[^1] = s;
        else collapsedSnapshots.Add(s);
    }

    var latestTePending = Model.backup.EggsOfTruthTotal - (int)Model.backup.EggsOfTruth;
    var latestDelivered = virtueEggs
        .Select((egg, i) => (egg, val: Model.backup.VirtueEggsDelivered.ElementAtOrDefault(i)))
        .ToDictionary(x => x.egg, x => x.val);
}

<div class="container">
    <div class="row">
        <div class="col-sm">
            <div class="card" style="margin-top:15px;">
                <h4 class="card-header" style="text-align: center;">Virtue Progress History</h4>
                <div class="table-responsive">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>TE (Total)</th>
                                <th>TE (Earned)</th>
                                <th>TE (Pending)</th>
                                <th>Current Egg</th>
                                @foreach (var egg in virtueEggs) {
                                    <th style="text-align: center;">@egg</th>
                                }
                                <th>Shifts</th>
                                <th>Resets</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>Latest</td>
                                <td>@Model.backup.EggsOfTruthTotal</td>
                                <td>@Model.backup.EggsOfTruth</td>
                                <td>@latestTePending</td>
                                <td>@Model.backup.MaxEggReached</td>
                                @foreach (var egg in virtueEggs) {
                                    <td style="text-align: center;">@eggAmount(latestDelivered[egg]) <span class="text-muted">(@eggLevel(latestDelivered[egg]))</span></td>
                                }
                                <td>@Model.backup.ShiftCount</td>
                                <td>@Model.backup.Resets</td>
                            </tr>
                            @foreach (var snapshot in collapsedSnapshots) {
                                <tr>
                                    <td>@snapshot.Date.ToString("yyyy-MM-dd")</td>
                                    <td>@snapshot.VirtueStats.TeTotal</td>
                                    <td>@snapshot.VirtueStats.TeEarned</td>
                                    <td>@snapshot.VirtueStats.TePending</td>
                                    <td>@snapshot.VirtueStats.CurrentEgg</td>
                                    @foreach (var egg in virtueEggs) {
                                        var delivered = snapshot.VirtueStats.Delivered.GetValueOrDefault(egg);
                                        <td style="text-align: center;">@eggAmount(delivered) <span class="text-muted">(@eggLevel(delivered))</span></td>
                                    }
                                    <td>@snapshot.VirtueStats.ShiftCount</td>
                                    <td>@snapshot.VirtueStats.Resets</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
