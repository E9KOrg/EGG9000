@using EGG9000.Common.Contracts.Assignment
@using EGG9000.Common.Database.Entities
@using EGG9000.Site.Models.MyFarms
@model MyFarms_Partial_TestAssignmentModel
@{
    var index = Model.index;
    var contracts = (Model.contracts ?? new List<DBContract>()).OrderByDescending(c => c.Created).ToList();
    var siblingApplies = Model.account.Assignment?.Redo.Mode == RedoLeggacyOption.YesOtherAccountMatch;
}

<div class="test-assignment" data-account-index="@index" style="margin-top:30px;">
    <div class="card">
        <div class="card-header"><b>Assignment Testing</b></div>
        <div class="card-body">
            <div class="form-group" style="max-width:600px;">
                <label for="ta-contract-@index">Contract</label>
                <div style="display:flex; gap:8px; align-items:flex-start;">
                    <input class="form-control ta-contract" id="ta-contract-@index" list="ta-contract-list-@index"
                           placeholder="Search contracts..." autocomplete="off" style="flex:1 1 auto;" />
                    <button type="button" class="btn btn-primary ta-test-btn" data-index="@index" style="flex:0 0 auto;">Test</button>
                </div>
                <datalist id="ta-contract-list-@index">
                    @foreach (var c in contracts) {
                        <option value="@c.Name (@c.ID)"></option>
                    }
                </datalist>
            </div>
            <div class="ta-sibling-wrap-@index" style="@(siblingApplies ? "" : "display:none;")">
                <div class="form-check form-switch" style="margin-top:8px;">
                    <input class="form-check-input ta-sibling-assigned" type="checkbox" role="switch" id="ta-sibling-@index" />
                    <label class="form-check-label" for="ta-sibling-@index">Simulate a sibling account being assigned</label>
                    <p style="font-size:0.82em; color:grey; margin:2px 0 0;">
                        Previews whether a sibling account getting assigned would pull this account in too (Leggacy redo or Seasonal force-assign).
                    </p>
                </div>
            </div>
            <div class="ta-result" id="ta-result-@index" style="margin-top:12px;"></div>
            <div style="margin-top:12px; padding:8px 12px; border:1px solid #e0a52b; border-radius:6px; background:rgba(224,165,43,.12); color:#e0a52b; font-size:0.85em;">
                Ignores current-round assignment (whether you are already in a co-op).
            </div>
        </div>
    </div>
</div>
