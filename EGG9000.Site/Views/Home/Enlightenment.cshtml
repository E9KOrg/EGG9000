@using EGG9000.Site.Models.Home
@model Home_EnlightenmentModel
@{
	Layout = "_LeaderboardLayout";
	ViewData["Title"] = "Enlightenment";

	var discordId = User.DiscordId();
	var isAdmin = User.IsStaff();
	var accounts = Model.Users.Where(x => x.Backup.Farms.Any(y => y.EggType == Ei.Egg.Enlightenment)).Select(x => {
		var farm = x.Backup.Farms.First(y => y.EggType == Ei.Egg.Enlightenment);
		var stats = farm.WithStats(x.Backup, null, Model.CustomEggs);
		return new {
			x.Backup,
			x.User,
			IsMe = x.DisplayDiscordId.ToString() == discordId,
			Farm = farm,
			x.DisplayName,
			FarmStats = stats,
			TimeToComplete = stats.InternalHatchery > 0 ? TimeSpan.FromMinutes((10e9 - farm.NumChickens) / (stats.InternalHatchery * 4 * 3)) : TimeSpan.MaxValue
		};
	}).OrderBy(x => x.TimeToComplete).ToList();

	ViewData[nameof(LeaderboardHeader)] = new LeaderboardHeader("Enlightenment Progress", $"{accounts.Count} farms")
		.Jump(accounts.Where(x => x.IsMe).Select(x => new LeaderboardJump(x.Backup.EggIncId, x.Backup.UserName)));
}

<table class="table table-striped table-hover lb-table">
	<thead>
		<tr>
			<th class="lb-rank">#</th>
			<th class="lb-left">Name</th>
			<th>EB</th>
			<th>Chickens</th>
			<th>Hab Space</th>
			<th>IHR</th>
			<th class="lb-sorted" title="Estimated days to 10B chickens">To 10B</th>
		</tr>
	</thead>
	<tbody>
		@foreach (var (account, i) in accounts.Select((x, i) => (x, i))) {
			var href = isAdmin ? $"/Home/ViewUser/{account.User.Id}" : account.IsMe ? "/MyFarms" : null;
			<tr id="@account.Backup.EggIncId" class="@(account.IsMe ? "lb-me" : "")">
				<partial name="_LeaderboardLead" model="new LeaderboardLead(i + 1, account.DisplayName, href)" />
				<td>@account.Backup.EarningsBonus.ToEggString()</td>
				<td>@account.Farm.NumChickens.ToEggString()</td>
				<td>@account.FarmStats.HabSpace.ToEggString()</td>
				<td>@account.FarmStats.InternalHatchery/m/hab</td>
				<td class="lb-sorted">@(account.TimeToComplete == TimeSpan.MaxValue ? "-" : $"{Math.Round(account.TimeToComplete.TotalDays)}d")</td>
			</tr>
		}
	</tbody>
</table>
