@model List<LeaderboardUser>
@{
	Layout = "_LeaderboardLayout";
	ViewData["Title"] = "CS Leaderboard";

	var discordId = User.DiscordId();
	var isAdmin = User.IsStaff();
	string rawType = ViewBag.CSType ?? "";
	var cstype = rawType == "season" ? "season" : "total";
	string q(string value) => Context.Request.WithQuery("cstype", value);

	var mine = Model.Where(x => x.DisplayDiscordId.ToString() == discordId);

	ViewData[nameof(LeaderboardHeader)] = new LeaderboardHeader("CS Leaderboard", $"{Model.Count} accounts")
		.Menu("Sort",
			new LeaderboardChoice("Total CS", q("total"), cstype == "total"),
			new LeaderboardChoice("Season CS", q("season"), cstype == "season"))
		.Jump(mine.Select(x => new LeaderboardJump(x.Backup.EggIncId, x.Backup.UserName)));

	string sorted(string key) => cstype == key ? "lb-sorted" : "";
}

<table class="table table-striped table-hover lb-table">
	<thead>
		<tr>
			<th class="lb-rank">#</th>
			<th class="lb-left">Name</th>
			<th class="@sorted("total")">Total CS</th>
			<th class="@sorted("season")">Season CS</th>
			<th>EB</th>
			<th title="Permit and grade"></th>
			<th title="Server coops / all coops">Coops</th>
		</tr>
	</thead>
	<tbody>
		@foreach (var (account, i) in Model.Select((x, i) => (x, i))) {
			var isMe = account.DisplayDiscordId.ToString() == discordId;
			var href = isAdmin ? $"/Home/ViewUser/{account.User.Id}" : isMe ? "/MyFarms" : null;
			var totalCoops = (account.Backup.ArchivedFarms?.Count ?? 0) + account.Backup.Farms.Count(x => !string.IsNullOrEmpty(x.ContractId));
			<tr id="@account.Backup.EggIncId" class="@(isMe ? "lb-me" : "")">
				<partial name="_LeaderboardLead" model="new LeaderboardLead(i + 1, account.DisplayName, href)" />
				<td class="@sorted("total")">@account.TotalCS.ToString("N0")</td>
				<td class="@sorted("season")">@account.SeasonCS.ToString("N0")</td>
				<td>@account.Backup.EarningsBonus.ToEggString(true, numberOfDecimalPlaces: 2)</td>
				<td>
					<span class="lb-icons">
						<img class="lb-icon" src="@(account.Backup.PermitLevel == 0 ? "https://cdn.discordapp.com/emojis/755734059761795173.png?v=1" : "https://cdn.discordapp.com/emojis/724392625276452955.png?v=1")" alt="@(account.Backup.PermitLevel == 0 ? "Standard permit" : "Pro permit")" />
						<img class="lb-icon" src="@PlayerGradeDetails.GetImage(account.Account.GetGrade())" alt="Grade" />
					</span>
				</td>
				<td>@account.TotalContracts/@totalCoops</td>
			</tr>
		}
	</tbody>
</table>
