@using EGG9000.Site.Models.Home
@model List<Home_EggDayResults>
@{
	Layout = "_LeaderboardLayout";
	ViewData["Title"] = "Egg Day Leaderboard";

	var discordId = User.DiscordId();
	int year = ViewBag.Year;
	int prefix = ViewBag.prefix;
	string rawSort = ViewBag.SortBy ?? "";
	var sortby = rawSort is "se" or "seper" or "prestige" ? rawSort : "eb";
	string q(string key, object value) => Context.Request.WithQuery(key, value.ToString());

	var rows = Model.Where(x => x.EBGain > 0 && x.PrestigeCount > 0).ToList();
	var mine = rows.Where(x => x.UserAccount.User.DiscordId.ToString() == discordId);

	ViewData[nameof(LeaderboardHeader)] = new LeaderboardHeader($"Egg Day Leaderboard {year}", $"{rows.Count} players")
		.Menu("Year", ((List<int>)ViewBag.Years).Select(y => new LeaderboardChoice(y.ToString(), q("year", y), y == year)))
		.Menu("Sort",
			new LeaderboardChoice("EB Gain", q("sortby", "eb"), sortby == "eb"),
			new LeaderboardChoice("SE Gain", q("sortby", "se"), sortby == "se"),
			new LeaderboardChoice("% Gain", q("sortby", "seper"), sortby == "seper"),
			new LeaderboardChoice("Prestiges", q("sortby", "prestige"), sortby == "prestige"))
		.Menu("Rank", [
			new LeaderboardChoice("All ranks", q("prefix", 0), prefix == 0),
			.. SIPrefix.Prefixes.Where(x => !string.IsNullOrEmpty(x.Name))
				.Select(p => new LeaderboardChoice(p.Rank, q("prefix", p.Base), prefix == p.Base, "#" + RankRegistry.ForOom(p.Base).ColorHex.TrimStart('#')))
		])
		.Jump(mine.Select(x => new LeaderboardJump(x.UserAccount.Account.Id, x.UserAccount.Account.Backup?.UserName ?? x.UserAccount.Account.Name)));

	string sorted(string key) => sortby == key ? "lb-sorted" : "";
}

@if (rows.Count == 0) {
	<div class="lb-empty">No Egg Day results for @year.</div>
} else {
	<table class="table table-striped table-hover lb-table">
		<thead>
			<tr>
				<th class="lb-rank">#</th>
				<th class="lb-left">Name</th>
				<th class="@sorted("eb")">EB Gain</th>
				<th class="@sorted("se")">SE Gain</th>
				<th class="@sorted("seper")">% Gain</th>
				<th class="@sorted("prestige")">Prestiges</th>
			</tr>
		</thead>
		<tbody>
			@foreach (var (account, i) in rows.Select((x, i) => (x, i))) {
				var isMe = account.UserAccount.User.DiscordId.ToString() == discordId;
				var lead = new LeaderboardLead(i + 1, Regex.Replace(account.UserAccount.User.DiscordUsername, @"\(.+?\)", "").Trim());
				<tr id="@account.UserAccount.Account.Id" class="@(isMe ? "lb-me" : "")">
					<partial name="_LeaderboardLead" model="lead" />
					<td class="@sorted("eb")">@account.EBGain.ToEggString()</td>
					<td class="@sorted("se")">@account.SEGain.ToEggString()</td>
					<td class="@sorted("seper")">@account.SEGainPercent.ToString("P0")</td>
					<td class="@sorted("prestige")">@account.PrestigeCount</td>
				</tr>
			}
		</tbody>
	</table>
}
