@using EGG9000.Site.Models.Home
@model List<Home_EggDayResults>
@inject Discord.WebSocket.DiscordSocketClient discord
@{
	ViewData["Title"] = "Leaderboard";

	var claimsIdentity = (System.Security.Claims.ClaimsIdentity)User.Identity;
	var discordId = claimsIdentity.Claims.First(x => x.Type == "DiscordId").Value;

	var myAccounts = Model.Where(x => x.UserAccount.User.DiscordId.ToString() == discordId).ToList();

	int year = ViewBag.Year;
	int prefix = ViewBag.prefix;
	string sortby = ViewBag.SortBy ?? "";

	string sortLabel = sortby switch {
		"se" => "SE Gain",
		"seper" => "% Gain",
		"prestige" => "Prestiges",
		_ => "EB Gain"
	};

	var activePrefix = prefix > 0 ? SIPrefix.Prefixes.FirstOrDefault(p => p.Base == prefix) : null;
	string prefixLabel = activePrefix is null ? "All ranks" : activePrefix.Rank;
	string prefixColor(int oom) => "#" + RankRegistry.ForOom(oom).ColorHex.TrimStart('#');

	string link(string s, int p, int y) => $"?sortby={s}&prefix={p}&year={y}";
}

<div class="container">
	<div class="card" style="margin-top:15px;">
		<div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
			<h4 class="mb-0">Egg Day Leaderboard @year</h4>
			<div class="d-flex flex-wrap gap-2">
				<div class="dropdown">
					<button class="btn btn-sm btn-outline-primary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">Year: @year</button>
					<ul class="dropdown-menu dropdown-menu-end">
						@foreach (var y in (List<int>)ViewBag.Years) {
							<li><a class="dropdown-item @(y == year ? "active" : "")" href="@link(sortby, prefix, y)">@y</a></li>
						}
					</ul>
				</div>

				<div class="dropdown">
					<button class="btn btn-sm btn-outline-primary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">Sort: @sortLabel</button>
					<ul class="dropdown-menu dropdown-menu-end">
						<li><a class="dropdown-item @(sortby is "" or "eb" ? "active" : "")" href="@link("eb", prefix, year)">EB Gain</a></li>
						<li><a class="dropdown-item @(sortby == "se" ? "active" : "")" href="@link("se", prefix, year)">SE Gain</a></li>
						<li><a class="dropdown-item @(sortby == "seper" ? "active" : "")" href="@link("seper", prefix, year)">% Gain</a></li>
						<li><a class="dropdown-item @(sortby == "prestige" ? "active" : "")" href="@link("prestige", prefix, year)">Prestiges</a></li>
					</ul>
				</div>

				<div class="dropdown">
					<button class="btn btn-sm btn-outline-primary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">Rank: @prefixLabel</button>
					<ul class="dropdown-menu dropdown-menu-end">
						<li><a class="dropdown-item @(prefix == 0 ? "active" : "")" href="@link(sortby, 0, year)">All ranks</a></li>
						@foreach (var p in SIPrefix.Prefixes.Where(x => !string.IsNullOrEmpty(x.Name))) {
							var hex = prefixColor(p.Base);
							<li><a class="dropdown-item @(prefix == p.Base ? "active" : "")" href="@link(sortby, p.Base, year)" style="border-left:4px solid @hex;"><span style="color:@hex;">@p.Rank</span></a></li>
						}
					</ul>
				</div>

				@if (myAccounts.Count == 1) {
					<a class="btn btn-sm btn-secondary" href="#@myAccounts.First().UserAccount.Account.Id">Jump to me</a>
				}
			</div>
		</div>

		@if (myAccounts.Count > 1) {
			<div class="card-body py-2 border-bottom d-flex flex-wrap gap-2 align-items-center">
				<span class="text-muted">Jump to:</span>
				@foreach (var account in myAccounts) {
					<a class="btn btn-sm btn-secondary" href="#@account.UserAccount.Account.Id">@(account.UserAccount.Account.Backup?.UserName ?? account.UserAccount.Account.Name)</a>
				}
			</div>
		}

		<div class="table-responsive">
			<table class="table table-striped table-sm align-middle mb-0">
				<thead>
					<tr>
						<th></th>
						<th style="text-align:left;">Name</th>
						<th>EB Gain</th>
						<th>SE Gain</th>
						<th>% Gain</th>
						<th>Prestiges</th>
					</tr>
				</thead>
				<tbody>
					@{
						var rank = 0;
						foreach (var account in Model.Where(x => x.EBGain > 0 && x.PrestigeCount > 0)) {
							rank++;
							RowTemplate(account, rank);
						}
					}
				</tbody>
			</table>
		</div>
	</div>
</div>

@{
	void RowTemplate(Home_EggDayResults account, int rank) {
		var isMe = account.UserAccount.User.DiscordId.ToString() == discordId;
		var name = Regex.Replace(account.UserAccount.User.DiscordUsername, @"\(.+?\)", "").Trim();

		<tr id="@account.UserAccount.Account.Id" class="@(isMe ? "Me" : "")">
			<td style="text-align:right;">@rank</td>
			<td>
				@if (isMe) {
					<div id="@account.UserAccount.Account.Id" class="jump-anchor"></div>
				}
				@name
			</td>
			<td>@account.EBGain.ToEggString()</td>
			<td>@account.SEGain.ToEggString()</td>
			<td>@account.SEGainPercent.ToString("P0")</td>
			<td>@account.PrestigeCount</td>
		</tr>
	}
}

<style>
	th {
		position: sticky;
		top: 0;
		text-align: center;
	}

	.Me td {
		background-color: #adffaa !important;
	}

	[data-bs-theme="dark"] .Me td {
		background-color: #2c462b !important;
	}

	.jump-anchor {
		position: relative;
		top: -40px;
	}
</style>
