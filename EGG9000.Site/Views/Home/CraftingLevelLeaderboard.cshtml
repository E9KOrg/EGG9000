@model List<LeaderboardUser>
@{
	Layout = "_LeaderboardLayout";
	ViewData["Title"] = "Crafting XP Leaderboard";

	var discordId = User.DiscordId();
	var isAdmin = User.IsStaff();
	var mine = Model.Where(x => x.DisplayDiscordId.ToString() == discordId);

	ViewData[nameof(LeaderboardHeader)] = new LeaderboardHeader("Crafting XP Leaderboard", $"{Model.Count} accounts")
		.Jump(mine.Select(x => new LeaderboardJump(x.Backup.EggIncId, x.Backup.UserName)));
}

<table class="table table-striped table-hover lb-table">
	<thead>
		<tr>
			<th class="lb-rank">#</th>
			<th class="lb-left">Name</th>
			<th>Crafting Level</th>
			<th class="lb-sorted">Crafting XP</th>
		</tr>
	</thead>
	<tbody>
		@foreach (var (account, i) in Model.Select((x, i) => (x, i))) {
			var isMe = account.DisplayDiscordId.ToString() == discordId;
			var href = isAdmin ? $"/Home/ViewUser/{account.User.Id}" : isMe ? "/MyFarms" : null;
			<tr id="@account.Backup.EggIncId" class="@(isMe ? "lb-me" : "")">
				<partial name="_LeaderboardLead" model="new LeaderboardLead(i + 1, account.DisplayName, href)" />
				<td>@account.Backup.GetCraftingLevel().ToString("N0")</td>
				<td class="lb-sorted">@account.Backup.CraftingXP.ToString("N0")</td>
			</tr>
		}
	</tbody>
</table>
