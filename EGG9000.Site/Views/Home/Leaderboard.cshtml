@model List<LeaderboardUser>
@{
	Layout = "_LeaderboardLayout";
	ViewData["Title"] = "Leaderboard";

	var discordId = User.DiscordId();
	var isAdmin = User.IsStaff();
	bool oldest = ViewBag.Oldest ?? false;
	string rawSort = ViewBag.SortBy ?? "";
	var sortby = rawSort is "se" or "pe" or "eot" or "eott" or "eov" or "tepershift" or "shifts" or "mer" or "permit" or "start" ? rawSort : "";
	var showVirtue = sortby is "eott" or "eov" or "tepershift";
	string q(string value) => Context.Request.WithQuery("sortby", value, "oldest");

	var soulIcon = Url.Content("~/images/Egg_soul.png");
	var prophecyIcon = Url.Content("~/images/Egg_of_Prophecy.png");
	var truthIcon = Url.Content("~/images/egg_truth.png");

	var mine = Model.Where(x => x.DisplayDiscordId.ToString() == discordId);

	ViewData[nameof(LeaderboardHeader)] = new LeaderboardHeader("Leaderboard")
		.Menu("Sort",
			new LeaderboardChoice("EB", q(""), sortby == "" && !oldest),
			new LeaderboardChoice("SE", q("se"), sortby == "se"),
			new LeaderboardChoice("PE", q("pe"), sortby == "pe"),
			new LeaderboardChoice("TE", q("eot"), sortby == "eot"),
			new LeaderboardChoice("TE w/Unclaimed", q("eott"), sortby == "eott"),
			new LeaderboardChoice("EoV", q("eov"), sortby == "eov"),
			new LeaderboardChoice("TE/Shift", q("tepershift"), sortby == "tepershift"),
			new LeaderboardChoice("Shifts", q("shifts"), sortby == "shifts"),
			new LeaderboardChoice("MER", q("mer"), sortby == "mer"),
			new LeaderboardChoice("Permit", q("permit"), sortby == "permit"),
			new LeaderboardChoice("First Contract", q("start"), sortby == "start"),
			new LeaderboardChoice("Oldest", Context.Request.WithQuery("oldest", "true", "sortby"), oldest))
		.Jump(mine.Select(LeaderboardLead.JumpLabel));
	var meIndex = 0;

	string sorted(string key) => sortby == key && !oldest ? "lb-sorted" : "";
}

<table class="table table-striped table-hover lb-table">
	<thead>
		<tr>
			<th class="lb-rank">#</th>
			<th class="lb-left">Name</th>
			@if (sortby == "mer") {
				<th class="lb-sorted">MER</th>
			}
			<th class="@sorted("se")" title="Soul Eggs"><img class="lb-icon" src="@soulIcon" alt="Soul Eggs" /></th>
			<th class="@sorted("pe")" title="Eggs of Prophecy"><img class="lb-icon" src="@prophecyIcon" alt="Eggs of Prophecy" /></th>
			<th class="@sorted("eot")" title="Eggs of Truth"><img class="lb-icon" src="@truthIcon" alt="Eggs of Truth" /></th>
			@if (showVirtue) {
				<th class="@sorted("eott")" title="Eggs of Truth including unclaimed"><img class="lb-icon" src="@truthIcon" alt="Eggs of Truth" />+</th>
				<th class="@sorted("eov")" title="Sum of Eggs of Virtue shipped">EoV</th>
				<th class="@sorted("tepershift")" title="Eggs of Truth per shift">TE/S</th>
			}
			<th class="@sorted("")">EB</th>
			<th class="@sorted("shifts")">Shifts</th>
			<th class="@sorted("permit")" title="Permit and grade"></th>
			@if (oldest) {
				<th class="lb-sorted">Joined</th>
			}
			@if (sortby == "start") {
				<th class="lb-sorted">Started</th>
			}
		</tr>
	</thead>
	<tbody>
		@foreach (var (account, i) in Model.Select((x, i) => (x, i))) {
			var lead = LeaderboardLead.For(account, i + 1, discordId, isAdmin);
			<tr id="@(lead.IsMe ? LeaderboardHeader.MeAnchor(meIndex++) : null)" class="@(lead.IsMe ? "lb-me" : "")">
				<partial name="_LeaderboardLead" model="lead" />
				@if (sortby == "mer") {
					<td class="lb-sorted">@account.Backup.MER</td>
				}
				<td class="@sorted("se")">@account.Backup.SoulEggs.ToEggString(true, numberOfDecimalPlaces: 2)</td>
				<td class="@sorted("pe")">@account.Backup.EggsOfProphecy</td>
				<td class="@sorted("eot")">@account.Backup.EggsOfTruth</td>
				@if (showVirtue) {
					var eov = account.Backup.VirtueEggsDelivered?.Sum() ?? 0;
					<td class="@sorted("eott")">@account.Backup.EggsOfTruthTotal</td>
					<td class="@sorted("eov")">@(eov > 0 ? eov.ToEggStringD(4) : "0")</td>
					<td class="@sorted("tepershift")">@(account.Backup.ShiftCount > 0 ? ((double)account.Backup.EggsOfTruthTotal / account.Backup.ShiftCount).ToString("0.00") : "")</td>
				}
				<td class="@sorted("")">@account.Backup.EarningsBonus.ToEggString(true, numberOfDecimalPlaces: 2)</td>
				<td class="@sorted("shifts")">@account.Backup.ShiftCount</td>
				<td>
					<span class="lb-icons">
						<img class="lb-icon" src="@(account.Backup.PermitLevel == 0 ? "https://cdn.discordapp.com/emojis/755734059761795173.png?v=1" : "https://cdn.discordapp.com/emojis/724392625276452955.png?v=1")" alt="@(account.Backup.PermitLevel == 0 ? "Standard permit" : "Pro permit")" />
						<img class="lb-icon" src="@PlayerGradeDetails.GetImage(account.Account.GetGrade())" alt="Grade" />
					</span>
				</td>
				@if (oldest) {
					<td class="lb-sorted">@account.User.Registered?.ToString("yyyy-MM-dd")</td>
				}
				@if (sortby == "start") {
					<td class="lb-sorted">@(account.Started == DateTimeOffset.MaxValue ? "" : account.Started.ToString("yyyy-MM-dd"))</td>
				}
			</tr>
		}
	</tbody>
</table>
